# npx auth secret
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Directory (tenant) id or verified domain. Required; multi-tenant values are refused (AUTH-4).
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

SHAREPOINT_HOSTNAME=contoso.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Matters
# Optional: a document library other than the site's default (MATTER-5: one per year)
SHAREPOINT_LIBRARY_NAME=
# "selected" (default, needs grantAppSiteAccess) or "all" for a development tenant (AUTH-5)
SHAREPOINT_SITE_ACCESS=

# Token store (AUTH-7). Required in production unless TOKEN_STORE=memory.
REDIS_URL=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TOKEN_STORE=

# Matters (MATTER-7, POLICY)
# "app" (default) or "delegated"
MATTER_PROVISIONING=
# Optional Entra group object id granted edit access on every new matter
MATTER_ADMIN_GROUP_ID=
# Optional retention label applied when a matter is closed
MATTER_CLOSED_RETENTION_LABEL=

# Change notifications (GRAPH-8): 16-128 random characters
GRAPH_NOTIFICATION_CLIENT_STATE=
