# bunx auth secret
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Directory (tenant) id or verified domain. Required; multi-tenant values are refused (AUTH-4).
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

SHAREPOINT_HOSTNAME=contoso.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Matters
# Library name. "{year}" selects one library per year (MATTER-10), e.g. "Matters {year}".
SHAREPOINT_LIBRARY_NAME=Matters {year}
# "selected" (default, needs grantAppSiteAccess) or "all" for a development tenant (AUTH-5)
SHAREPOINT_SITE_ACCESS=

# Token store (AUTH-7). Staging: Redis on the EC2 instance; production: ElastiCache.
# Required in production unless TOKEN_STORE=memory.
REDIS_URL=redis://127.0.0.1:6379
# openssl rand -base64 32. Keep in AWS Secrets Manager with the client secret (AUTH-8).
TOKEN_ENCRYPTION_KEY=
TOKEN_STORE=

# Matters (MATTER-7, POLICY)
# "app" (default) or "delegated"
MATTER_PROVISIONING=
# Entra group object ids granted edit on every new matter. Both required to create matters.
# Firm admins (POLICY-7):
MATTER_ADMIN_GROUP_ID=
# Team leaders (POLICY-8):
MATTER_LEADERS_GROUP_ID=
# Comma-separated firm email domains; anyone else is external (POLICY-9)
FIRM_EMAIL_DOMAINS=
# Optional retention label applied when a matter is closed (MATTER-9)
MATTER_CLOSED_RETENTION_LABEL=

# Change notifications (GRAPH-8): 16-128 random characters
GRAPH_NOTIFICATION_CLIENT_STATE=

# Live probes (probe/*.ts, ../probe-results.md). Names only; real values go in .env.local (R-5).
SP_TENANT_ID=
SP_APP_CLIENT_ID=
SP_APP_CERT_THUMBPRINT=
SP_APP_CERT_KEY=
SP_SITE_ID=
SP_DRIVE_ID=
QA_AGENT_SMITH_UPN=
QA_AGENT_SMITH_PASSWORD=
QA_AGENT_SMITH_TOTP_SECRET=
PROBE_SCRATCH=
